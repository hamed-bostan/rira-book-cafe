
# .nvmrc is read by nvm and actions/setup-node on Linux; a trailing CR makes
# the version string unparseable. Keep it LF regardless of core.autocrlf.
.nvmrc text eol=lf

# Shell scripts, systemd units and nginx config run on the Linux VPS.
*.sh text eol=lf
deploy/* text eol=lf
nginx/** text eol=lf
