{
  "name": "rira-book-cafe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run generate:tokens",
    "prebuild": "npm run generate:tokens",
    "dev": "next dev",
    "build": "next build",
    "analyze": "npm run generate:tokens && next build --webpack",
    "bundle:size": "node scripts/bundle-size.mjs",
    "bundle:check": "node scripts/bundle-size.mjs --check",
    "audit": "node scripts/audit.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "generate:tokens": "tsx src/presentation/design-system/scripts/generate-css.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^11.8.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.2",
    "nodemailer": "^10.1.7",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer",
      "@auth/core": {
        "nodemailer": "$nodemailer"
      }
    }
  }
}
