// Rira Book Cafe database schema.
// Data lives in PostgreSQL. Images live in Supabase Storage — rows store only the image's URL.

// Generated into infrastructure — the only layer that talks to the database — and
// not committed: run `npm run db:generate` after a schema change (and after a fresh
// clone; `npm install` no longer generates it).
generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/prisma/generated"
}

// The connection URL lives in `prisma.config.ts` for the CLI, and in the driver
// adapter in `src/infrastructure/prisma/client.ts` for the app.
datasource db {
  provider = "postgresql"
}

model User {
  // id is the user's normalized phone digits — the stable identifier carried on
  // the Auth.js session (and matched against ADMIN_USER_IDS), so it is supplied
  // at creation rather than database-generated.
  id              String    @id
  phone           String
  name            String
  email           String?
  avatarUrl       String?   @map("avatar_url")
  // Access level: "customer" (default), "support", "staff", "admin", or "owner" —
  // stored as a plain string matching the domain union (enum-free style). This is
  // the source of truth for dashboard access; ADMIN_USER_IDS remains only as a
  // break-glass allowlist so an owner can always get back in.
  role            String    @default("customer")
  // A guest profile staff made from the phone a guest gave them: who made it. Null
  // for one made by signing in, and for one an old record's backfill made.
  createdById     String?   @map("created_by_id")
  // When the phone first signed in; null for a profile made for a guest who
  // hasn't signed in yet.
  firstSignedInAt DateTime? @map("first_signed_in_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([role])
  @@map("users")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  iconUrl   String    @map("icon_url")
  // Off: the category and every item in it are off the public menu (see
  // `isOnPublicMenu`), and can't be ordered — the items keep their own switches.
  isActive  Boolean   @default(true) @map("is_active")
  // Where it sits on the menu, first = 0. Staff move categories up and down from
  // the dashboard; a new one goes to the end.
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@index([isActive])
  @@index([position])
  @@map("categories")
}

model CategoryTranslation {
  id         String   @id @default(uuid())
  categoryId String   @map("category_id")
  locale     String
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([categoryId, locale])
  @@index([categoryId])
  @@map("category_translations")
}

// A menu item: a drink, a food item, or a book on the shelf. Prices are whole
// Toman. Book columns are set only when kind = "book" (the repository clears them
// otherwise); kind and book_availability are plain strings matching the domain
// unions (enum-free style).
model Product {
  id               String       @id @default(uuid())
  kind             String       @default("drink")
  name             String
  price            Int
  originalPrice    Int?         @map("original_price")
  // What one unit costs the cafe (Toman), for cost of sales. Never shown to guests.
  costPrice        Int?         @map("cost_price")
  rating           Float        @default(0)
  ratingCount      Int          @default(0) @map("rating_count")
  stockQuantity    Int          @default(0) @map("stock_quantity")
  // Made when ordered (drinks, breakfast): never counted, so ordering neither
  // checks nor takes `stockQuantity`, and its warnings come from its recipe.
  madeToOrder      Boolean      @default(false) @map("made_to_order")
  imageUrl         String       @map("image_url")
  // Always a category that exists: the key refuses an unknown one (the use-cases
  // check first, for a field error), and refuses deleting a category that still
  // has items (`DeleteCategory` refuses first, naming how many).
  categoryId       String       @map("category_id")
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isFeatured       Boolean      @default(false) @map("is_featured")
  isPublished      Boolean      @default(true) @map("is_published")
  badge            String?
  unit             String?
  description      String?
  nutrition        String?
  origin           String?
  dietary          String[]     @default([])
  // VAT-exempt (books, in Iran). Prices are VAT-inclusive; exempt items carry none.
  taxExempt        Boolean      @default(false) @map("tax_exempt")
  bookAuthor       String?      @map("book_author")
  // Copies of a book the shelf lends; null reads as one.
  bookCopies       Int?         @map("book_copies")
  bookIsbn         String?      @map("book_isbn")
  bookAvailability String?      @map("book_availability")
  // The owner's profit target for this item, as a markup on full cost in basis
  // points (3000 = 30%); null uses the cafe-wide default in pricing settings.
  targetMarkupBps  Int?         @map("target_markup_bps")
  recipeLines      RecipeLine[]
  optionGroups     ProductOptionGroup[]
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isPublished])
  @@index([kind])
  @@map("products")
}

// A group of choices on a menu item — Size, Extras (see domain/entities/ProductOptions).
// `selection` is "single" or "multiple" (enum-free style). Names are the English base
// and an optional Persian one. Goes with its item.
model ProductOptionGroup {
  id         String                @id @default(uuid())
  productId  String                @map("product_id")
  product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  nameFa     String?               @map("name_fa")
  required   Boolean               @default(false)
  selection  String                @default("single")
  minChoices Int                   @default(0) @map("min_choices")
  // Null: as many as the group has.
  maxChoices Int?                  @map("max_choices")
  position   Int
  choices    ProductOptionChoice[]
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  @@index([productId, position])
  @@map("product_option_groups")
}

// One choice in an option group. `price_delta` is whole Toman added to the item's price.
// Order lines snapshot what they chose, so changing or removing a choice never touches
// a past order.
model ProductOptionChoice {
  id          String             @id @default(uuid())
  groupId     String             @map("group_id")
  group       ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  nameFa      String?            @map("name_fa")
  priceDelta  Int                @default(0) @map("price_delta")
  isAvailable Boolean            @default(true) @map("is_available")
  isDefault   Boolean            @default(false) @map("is_default")
  position    Int
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([groupId, position])
  @@map("product_option_choices")
}

model ProductTranslation {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  locale      String
  name        String
  unit        String?
  description String?
  nutrition   String?
  origin      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([productId, locale])
  @@index([productId])
  @@map("product_translations")
}

// Append-only audit trail of admin changes. Written by repositories inside the
// same transaction as the change they describe.
model ActivityEntry {
  id            String   @id @default(uuid())
  actorId       String   @map("actor_id")
  actorName     String   @map("actor_name")
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  entityLabel   String?  @map("entity_label")
  // `[{ field, before, after }]` with string values.
  changes       Json
  // Field names from `changes`, denormalized so "every price change" is an index scan.
  changedFields String[] @map("changed_fields")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("activity_log")
}

// A cafe order. Guest name/phone and every line's name/price are snapshotted at
// placement so the order reads correctly after the menu or the account changes.
// status / service_type / payment_status are plain strings matching the domain
// unions (enum-free style).
model Order {
  id               String             @id @default(uuid())
  // Short sequential number staff call out.
  orderNumber      Int                @unique @default(autoincrement()) @map("order_number")
  // The guest's profile (a user id is a normalized phone). Null only on an old
  // counter sale that had no usable phone — every sale since has a profile.
  userId           String?            @map("user_id")
  customerName     String             @map("customer_name")
  customerPhone    String             @map("customer_phone")
  status           String             @default("pending")
  serviceType      String             @map("service_type")
  tableLabel       String?            @map("table_label")
  note             String?
  paymentStatus    String             @default("unpaid") @map("payment_status")
  // cash | card | transfer | online, once paid (kept after a refund). The largest
  // part when the bill was split; `payment_parts` holds every part.
  paymentMethod    String?            @map("payment_method")
  paymentParts     OrderPaymentPart[]
  // Handed back on a completed order, in Toman (`refunds` are the documents).
  refundedTotal    Int                @default(0) @map("refunded_total")
  refunds          OrderRefund[]
  subtotal         Int
  // The promo code applied at placement (snapshotted text; the id counts its uses).
  promoCodeId      String?            @map("promo_code_id")
  promoCode        String?            @map("promo_code")
  promoDiscount    Int                @default(0) @map("promo_discount")
  // Loyalty points spent on this order, and the Toman they took off.
  pointsRedeemed   Int                @default(0) @map("points_redeemed")
  pointsDiscount   Int                @default(0) @map("points_discount")
  // Points the guest earned when it was completed.
  pointsEarned     Int                @default(0) @map("points_earned")
  // The service charge on the order, in Toman (VAT inside it), and the rate it was
  // priced at in basis points — snapshotted, so a rate changed later leaves it alone.
  serviceCharge    Int                @default(0) @map("service_charge")
  serviceChargeBps Int                @default(0) @map("service_charge_bps")
  total            Int
  items            OrderItem[]
  paymentAttempts  PaymentAttempt[]
  placedAt         DateTime           @default(now()) @map("placed_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  // When staff last changed its lines, table or service after it was placed.
  changedAt        DateTime?          @map("changed_at")

  @@index([status, placedAt])
  @@index([userId, placedAt])
  @@index([promoCodeId])
  @@map("orders")
}

model OrderItem {
  id               String            @id @default(uuid())
  orderId          String            @map("order_id")
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Plain reference, not a foreign key: deleting a menu item must not touch history.
  productId        String            @map("product_id")
  kind             String
  name             String
  imageUrl         String            @map("image_url")
  unitPrice        Int               @map("unit_price")
  // Cost per unit when placed, if the item had one — for cost of sales.
  unitCost         Int?              @map("unit_cost")
  // Whether the item was VAT-exempt when placed (books are); the sale's VAT comes from the rest.
  taxExempt        Boolean           @default(false) @map("tax_exempt")
  // Set at completion when the line's recipe was taken out of stock (unit_cost is then actual).
  stockTracked     Boolean           @default(false) @map("stock_tracked")
  quantity         Int
  // Units of this line handed back after the order was completed.
  refundedQuantity Int               @default(0) @map("refunded_quantity")
  note             String?
  // The options chosen, snapshotted: `[{ groupId, group, groupFa?, choiceId, choice,
  // choiceFa?, priceDelta }]` (see domain/entities/ProductOptions). `unit_price`
  // already includes the deltas. `[]` for a line without options.
  options          Json              @default("[]")
  position         Int
  // When staff marked the line served; null while it's still being prepared.
  servedAt         DateTime?         @map("served_at")
  // When staff added the line to an order already placed (a second round); null for the lines it was placed with.
  addedAt          DateTime?         @map("added_at")
  refundLines      OrderRefundLine[]

  @@index([orderId])
  @@map("order_items")
}

// One part of how an order was paid (see domain/entities/Order). Amounts are whole
// Toman and add up to the order's total.
model OrderPaymentPart {
  id       String @id @default(uuid())
  orderId  String @map("order_id")
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method   String
  amount   Int
  position Int

  @@index([orderId])
  @@index([method])
  @@map("order_payment_parts")
}

// Money handed back on a completed order (see domain/entities/OrderRefund).
model OrderRefund {
  id            String            @id @default(uuid())
  number        Int               @unique @default(autoincrement())
  orderId       String            @map("order_id")
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  date          DateTime          @db.Date
  // cash | card | transfer | online
  method        String
  amount        Int
  vatAmount     Int               @map("vat_amount")
  reason        String?
  lines         OrderRefundLine[]
  createdById   String            @map("created_by_id")
  createdByName String            @map("created_by_name")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_refunds")
}

model OrderRefundLine {
  id               String      @id @default(uuid())
  refundId         String      @map("refund_id")
  refund           OrderRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId      String      @map("order_item_id")
  orderItem        OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  name             String
  kind             String
  quantity         Int
  amount           Int
  vatAmount        Int         @map("vat_amount")
  // The service charge share inside `amount`, and the VAT inside that share.
  serviceCharge    Int         @default(0) @map("service_charge")
  serviceChargeVat Int         @default(0) @map("service_charge_vat")
  // Whether the units went back on the shelf (a book can; a drink can't).
  restocked        Boolean     @default(false)
  position         Int

  @@index([refundId])
  @@index([orderItemId])
  @@map("order_refund_lines")
}

// One try at paying an order online (see domain/entities/PaymentAttempt).
// Amounts are whole Toman, like the order's total.
model PaymentAttempt {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // zarinpal
  provider      String
  // The gateway's id for the try; a callback names exactly one attempt.
  authority     String   @unique
  amount        Int
  // pending | verifying | paid | failed | unapplied | refunded
  status        String   @default("pending")
  // The order id while the attempt is live (pending/verifying), null after: the
  // unique index allows one live attempt per order.
  liveOrderId   String?  @unique @map("live_order_id")
  failureReason String?  @map("failure_reason")
  gatewayCode   String?  @map("gateway_code")
  refId         String?  @map("ref_id")
  cardPan       String?  @map("card_pan")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([orderId, createdAt])
  @@map("payment_attempts")
}

// Append-only: one row per status change (and one for placement, with from = null).
model OrderStatusEvent {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  // status | changed — a move along the workflow, or staff changing the order without moving it.
  kind       String   @default("status")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorId    String   @map("actor_id")
  actorName  String   @map("actor_name")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model OrderNote {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  authorId   String   @map("author_id")
  authorName String   @map("author_name")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_notes")
}

// A table booking. status is a plain string matching the domain union.
model Reservation {
  id              String    @id @default(uuid())
  reference       Int       @unique @default(autoincrement())
  // The guest's profile: staff booking for a guest find or make it by phone.
  // Null only on an old booking that had no usable phone.
  userId          String?   @map("user_id")
  guestName       String    @map("guest_name")
  guestPhone      String    @map("guest_phone")
  partySize       Int       @map("party_size")
  startsAt        DateTime  @map("starts_at")
  // How long the table is held; never over six hours (a CHECK in the migration).
  durationMinutes Int       @map("duration_minutes")
  status          String    @default("requested")
  // Set when the jobs cancelled a request nobody answered before it began.
  expiredAt       DateTime? @map("expired_at")
  tableLabel      String?   @map("table_label")
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  // A deposit taken against the booking, in Toman; 0 when none was (see domain/entities/ReservationDeposit).
  depositAmount   BigInt    @default(0) @map("deposit_amount")
  // cash | card | transfer, when a deposit was taken
  depositMethod   String?   @map("deposit_method")
  // held | returned | kept, when a deposit was taken
  depositState    String?   @map("deposit_state")

  // The floor's day view, and the table-clash check.
  @@index([startsAt])
  @@index([tableLabel, startsAt])
  @@index([userId, startsAt])
  @@map("reservations")
}

// A stay in the cafe's suite. check_in/check_out are cafe days; the guest sleeps
// the nights from check_in up to (not including) check_out. Two stays holding the
// suite (confirmed, checkedIn) can't overlap — also enforced by an exclusion
// constraint in the migration, not only in app code.
model SuiteBooking {
  id         String    @id @default(uuid())
  reference  Int       @unique @default(autoincrement())
  // The guest's profile, as on a reservation; null only on an old stay without a usable phone.
  userId     String?   @map("user_id")
  guestName  String    @map("guest_name")
  guestPhone String    @map("guest_phone")
  guests     Int
  checkIn    DateTime  @map("check_in") @db.Date
  checkOut   DateTime  @map("check_out") @db.Date
  status     String    @default("requested")
  // Set when the jobs cancelled a request nobody answered by its arrival day.
  expiredAt  DateTime? @map("expired_at")
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  // The stay's nightly rate in Toman (`nightlyRate` in the domain), snapshotted from
  // suite_settings when the stay is made (or confirmed); null for a stay from before
  // the suite had a price. The total is never stored: it's the nights times this.
  nightRate  BigInt?   @map("nightly_rate")

  @@index([checkOut, checkIn])
  @@index([userId, checkIn])
  @@map("suite_bookings")
}

// A book lent from the shelf: who has it and when it's due back. The book's title
// is snapshotted, like an order line, so the record survives the catalog changing.
// One borrower can't hold two open loans of the same book (partial unique index in
// the migration).
model BookLoan {
  id            String    @id @default(uuid())
  reference     Int       @unique @default(autoincrement())
  productId     String    @map("product_id")
  bookTitle     String    @map("book_title")
  bookAuthor    String?   @map("book_author")
  userId        String?   @map("user_id")
  borrowerName  String    @map("borrower_name")
  borrowerPhone String    @map("borrower_phone")
  lentAt        DateTime  @map("lent_at")
  dueAt         DateTime  @map("due_at")
  status        String    @default("out")
  returnedAt    DateTime? @map("returned_at")
  note          String?
  // Money left against the book, in Toman; 0 when none was taken.
  depositAmount BigInt    @default(0) @map("deposit_amount")
  // cash | bank, when a deposit was taken
  depositMethod String?   @map("deposit_method")
  // held | returned | kept, when a deposit was taken
  depositState  String?   @map("deposit_state")
  lentById      String    @map("lent_by_id")
  lentByName    String    @map("lent_by_name")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, dueAt])
  @@index([productId, status])
  @@index([borrowerPhone])
  @@index([userId, lentAt])
  @@map("book_loans")
}

// Something guests sign up for — a book club, a reading, a workshop.
model Event {
  id            String              @id @default(uuid())
  kind          String
  title         String
  description   String?
  titleFa       String?             @map("title_fa")
  descriptionFa String?             @map("description_fa")
  imageUrl      String?             @map("image_url")
  startsAt      DateTime            @map("starts_at")
  endsAt        DateTime            @map("ends_at")
  // Null means no seat limit.
  capacity      Int?
  // Toman; 0 is free.
  price         Int                 @default(0)
  isPublished   Boolean             @default(false) @map("is_published")
  // Floor tables held for the event while it runs (`CafeTable` labels, floor
  // order); guest bookings can't take them then. Checked under the same per-table
  // advisory lock as reservations.
  tableLabels   String[]            @default([]) @map("table_labels")
  registrations EventRegistration[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([isPublished, startsAt])
  @@index([tableLabels], type: Gin)
  @@map("events")
}

model EventRegistration {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId     String   @map("user_id")
  guestName  String   @map("guest_name")
  guestPhone String   @map("guest_phone")
  seats      Int
  status     String   @default("registered")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventId, status])
  @@index([userId, createdAt])
  @@map("event_registrations")
}

// ── Accounting ───────────────────────────────────────────────────────────────
// Double-entry general ledger in whole Toman. Amounts are BIGINT so large
// purchases can't overflow. Balance, immutability and amount rules are also
// enforced in the database (see the accounting migration), not only in app code.

model LedgerAccount {
  // Stable code; the first digit is the type (1 asset, 2 liability, 3 equity, 4 revenue, 5–6 expense).
  code           String          @id
  name           String
  nameFa         String          @map("name_fa")
  // asset | liability | equity | revenue | expense
  type           String
  isSystem       Boolean         @default(false) @map("is_system")
  isActive       Boolean         @default(true) @map("is_active")
  lines          JournalLine[]
  expenses       Expense[]
  incomes        Income[]
  bankStatements BankStatement[]
  recurringBills RecurringBill[]
  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("ledger_accounts")
}

model JournalEntry {
  id            String        @id @default(uuid())
  number        Int           @unique @default(autoincrement())
  // The accounting date (a cafe day).
  date          DateTime      @db.Date
  description   String
  source        String
  sourceId      String?       @map("source_id")
  // Postings that must happen once (an order's sale) carry a key; a second is refused.
  uniqueKey     String?       @unique @map("unique_key")
  // On a reversing entry: the entry it reverses (each entry can be reversed once).
  reversesId    String?       @unique @map("reverses_id")
  // On a reversed entry: the reversing entry. The only column that may change after posting.
  reversedById  String?       @map("reversed_by_id")
  createdById   String        @map("created_by_id")
  createdByName String        @map("created_by_name")
  lines         JournalLine[]
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([date])
  @@index([source, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id          String               @id @default(uuid())
  entryId     String               @map("entry_id")
  entry       JournalEntry         @relation(fields: [entryId], references: [id], onDelete: Restrict)
  accountCode String               @map("account_code")
  account     LedgerAccount        @relation(fields: [accountCode], references: [code], onDelete: Restrict)
  debit       BigInt               @default(0)
  credit      BigInt               @default(0)
  memo        String?
  position    Int
  bankMatch   BankMatchLedgerLine?

  @@index([entryId])
  @@index([accountCode])
  @@map("journal_lines")
}

// One row (id = 1).
model AccountingSettings {
  id                 Int       @id @default(1)
  // VAT included in menu prices, in basis points (1000 = 10%).
  vatRateBps         Int       @default(1000) @map("vat_rate_bps")
  // Service charge on dine-in orders, in basis points (1000 = 10%); 0 = off.
  serviceChargeBps   Int       @default(0) @map("service_charge_bps")
  // Nothing may be posted on or before this day.
  booksClosedThrough DateTime? @map("books_closed_through") @db.Date
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("accounting_settings")
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  phone          String?
  note           String?
  isActive       Boolean         @default(true) @map("is_active")
  expenses       Expense[]
  recurringBills RecurringBill[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("suppliers")
}

model Expense {
  id            String            @id @default(uuid())
  number        Int               @unique @default(autoincrement())
  date          DateTime          @db.Date
  supplierId    String?           @map("supplier_id")
  supplier      Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName  String?           @map("supplier_name")
  accountCode   String            @map("account_code")
  account       LedgerAccount     @relation(fields: [accountCode], references: [code], onDelete: Restrict)
  description   String
  amount        BigInt
  vatAmount     BigInt            @default(0) @map("vat_amount")
  // unpaid | paid | void
  status        String
  // Paid off so far; stays below `amount` while the expense is `unpaid`. Each
  // payment is an `expensePayment` journal entry on the expense.
  paidAmount    BigInt            @default(0) @map("paid_amount")
  // cash | bank, once paid in full
  paidFrom      String?           @map("paid_from")
  paidOn        DateTime?         @map("paid_on") @db.Date
  receiptUrl    String?           @map("receipt_url")
  createdById   String            @map("created_by_id")
  createdByName String            @map("created_by_name")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  recurringRun  RecurringBillRun?

  @@index([date])
  @@index([status])
  @@index([supplierId])
  @@map("expenses")
}

// Someone the cafe pays (see domain/entities/Payroll). Not a login: not everyone on
// the payroll has one.
model Employee {
  id            String       @id @default(uuid())
  name          String
  position      String?
  phone         String?
  // The usual gross, in whole Toman: where a first pay run starts from.
  monthlySalary BigInt       @default(0) @map("monthly_salary")
  isActive      Boolean      @default(true) @map("is_active")
  payLines      PayRunLine[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("employees")
}

// A month's pay. The migration's partial unique index `pay_runs_one_per_period`
// allows one standing run a month; a voided run frees its month.
model PayRun {
  id            String       @id @default(uuid())
  // The Persian month, "1405-08".
  period        String
  date          DateTime     @db.Date
  // unpaid | paid | void
  status        String
  // Net pay paid out so far. Each payment is a `payrollPayment` journal entry.
  paidAmount    BigInt       @default(0) @map("paid_amount")
  // cash | bank, once paid in full
  paidFrom      String?      @map("paid_from")
  paidOn        DateTime?    @map("paid_on") @db.Date
  lines         PayRunLine[]
  createdById   String       @map("created_by_id")
  createdByName String       @map("created_by_name")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("pay_runs")
}

// One person's month, in the figures the accountant gave.
model PayRunLine {
  id                String   @id @default(uuid())
  runId             String   @map("run_id")
  run               PayRun   @relation(fields: [runId], references: [id], onDelete: Restrict)
  employeeId        String   @map("employee_id")
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // Snapshotted, so an old run reads correctly after a rename.
  employeeName      String   @map("employee_name")
  gross             BigInt
  employeeInsurance BigInt   @default(0) @map("employee_insurance")
  incomeTax         BigInt   @default(0) @map("income_tax")
  employerInsurance BigInt   @default(0) @map("employer_insurance")

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@map("pay_run_lines")
}

// A bill that comes round every Persian month (see domain/entities/RecurringBill).
// Nothing is booked from it on its own: each month is put in front of someone.
model RecurringBill {
  id          String             @id @default(uuid())
  description String
  accountCode String             @map("account_code")
  account     LedgerAccount      @relation(fields: [accountCode], references: [code], onDelete: Restrict)
  supplierId  String?            @map("supplier_id")
  supplier    Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  amount      BigInt
  vatAmount   BigInt             @default(0) @map("vat_amount")
  dayOfMonth  Int                @map("day_of_month")
  startsOn    DateTime           @map("starts_on") @db.Date
  isActive    Boolean            @default(true) @map("is_active")
  runs        RecurringBillRun[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("recurring_bills")
}

// A month of a bill that's been dealt with. The key is what stops a month being
// booked twice; the row commits in the expense's own transaction.
model RecurringBillRun {
  billId        String        @map("bill_id")
  bill          RecurringBill @relation(fields: [billId], references: [id], onDelete: Restrict)
  // The Persian month, "1405-08".
  period        String
  // The expense it became; null when the month was skipped. Voiding that expense
  // removes this row, so the month comes due again.
  expenseId     String?       @unique @map("expense_id")
  expense       Expense?      @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  createdById   String        @map("created_by_id")
  createdByName String        @map("created_by_name")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@id([billId, period])
  @@map("recurring_bill_runs")
}

// Money that came in outside an order (see domain/entities/Income).
model Income {
  id            String         @id @default(uuid())
  number        Int            @unique @default(autoincrement())
  date          DateTime       @db.Date
  accountCode   String         @map("account_code")
  account       LedgerAccount  @relation(fields: [accountCode], references: [code], onDelete: Restrict)
  description   String
  amount        BigInt
  vatAmount     BigInt         @default(0) @map("vat_amount")
  // cash | card | transfer
  method        String
  payerName     String?        @map("payer_name")
  // What it was paid for, when it was: eventRegistration | suiteBooking, and its id.
  sourceType    String?        @map("source_type")
  sourceId      String?        @map("source_id")
  // received | void
  status        String         @default("received")
  createdById   String         @map("created_by_id")
  createdByName String         @map("created_by_name")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refunds       IncomeRefund[]

  @@index([date])
  @@index([status])
  @@index([sourceType, sourceId])
  @@map("incomes")
}

// Money handed back from a payment on a suite stay or an event sign-up, in part or
// in full (see domain/entities/IncomeRefund). Its entry takes the amount back out of
// the payment's revenue account and VAT, and out of the cash register or the bank.
model IncomeRefund {
  id            String   @id @default(uuid())
  number        Int      @unique @default(autoincrement())
  incomeId      String   @map("income_id")
  income        Income   @relation(fields: [incomeId], references: [id], onDelete: Restrict)
  // The booking it was paid for, copied from the income: eventRegistration | suiteBooking, and its id.
  sourceType    String   @map("source_type")
  sourceId      String   @map("source_id")
  date          DateTime @db.Date
  amount        BigInt
  vatAmount     BigInt   @default(0) @map("vat_amount")
  // cash | card | transfer
  method        String
  reason        String?
  createdById   String   @map("created_by_id")
  createdByName String   @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([incomeId])
  @@index([sourceType, sourceId])
  @@map("income_refunds")
}

// The suite's price: one row (id 1).
model SuiteSettings {
  id          Int      @id @default(1)
  // What a night costs, in Toman — snapshotted onto each stay as it's made.
  nightlyRate BigInt   @default(2500000) @map("nightly_rate")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("suite_settings")
}

// --- Pricing: ingredients, recipes and the advisor's settings.

// Something menu items are made from, priced as bought: purchase_price Toman for
// purchase_quantity units (g, ml or piece).
model Ingredient {
  id               String          @id @default(uuid())
  name             String
  unit             String
  purchasePrice    BigInt          @map("purchase_price")
  purchaseQuantity Float           @map("purchase_quantity")
  isActive         Boolean         @default(true) @map("is_active")
  // Perpetual inventory: on hand (in unit), its value in Toman (always equal to
  // what the Inventory account holds for it), weighted average cost per unit, and
  // the level at or below which it shows as running low.
  onHand           Float           @default(0) @map("on_hand")
  stockValue       BigInt          @default(0) @map("stock_value")
  averageCost      Float           @default(0) @map("average_cost")
  reorderLevel     Float?          @map("reorder_level")
  recipeLines      RecipeLine[]
  stockMovements   StockMovement[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("ingredients")
}

// One ingredient in a menu item's recipe. An ingredient in use can't be deleted
// (Restrict) — it's switched off instead.
model RecipeLine {
  id           String     @id @default(uuid())
  productId    String     @map("product_id")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String     @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Float
  position     Int

  @@unique([productId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_lines")
}

// The pricing advisor's settings — a single row.
model PricingSettings {
  id                    Int      @id @default(1)
  defaultMarkupBps      Int      @default(3000) @map("default_markup_bps")
  roundingStep          Int      @default(5000) @map("rounding_step")
  overheadSource        String   @default("ledger") @map("overhead_source")
  manualMonthlyOverhead BigInt?  @map("manual_monthly_overhead")
  expectedMonthlyUnits  Int?     @map("expected_monthly_units")
  overheadMonths        Int      @default(3) @map("overhead_months")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("pricing_settings")
}

// One change to one stock item — append-only, like the journal. Quantity and value
// are signed (in positive, out negative); reference_id is the order, receipt
// (expense) or count it belongs to.
model StockMovement {
  id            String     @id @default(uuid())
  ingredientId  String     @map("ingredient_id")
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  kind          String
  quantity      Float
  value         BigInt
  date          DateTime   @db.Date
  referenceId   String?    @map("reference_id")
  note          String?
  createdById   String     @map("created_by_id")
  createdByName String     @map("created_by_name")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([ingredientId, date])
  @@index([referenceId])
  @@index([date])
  @@map("stock_movements")
}

// A message to one guest, shown on their account (no SMS): an order is ready, a
// booking was confirmed, a borrowed book is due. The copy is rendered from `kind`
// and `params` in the guest's language.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  kind      String
  // The values the message is filled with, e.g. `{ "orderNumber": 42 }`.
  params    Json      @default("{}")
  // Where tapping it goes, a site path such as `/orders/…`.
  link      String?
  // Notifications that must happen at most once (a loan's due-soon reminder) carry a key.
  dedupeKey String?   @unique @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

// A guest's star rating (and optional words) for something they bought. Shown once
// staff approve it; the item's rating is the average of its approved reviews.
model ProductReview {
  id              String    @id @default(uuid())
  productId       String    @map("product_id")
  productName     String    @map("product_name")
  userId          String    @map("user_id")
  authorName      String    @map("author_name")
  rating          Int
  comment         String?
  status          String    @default("pending")
  moderatedById   String?   @map("moderated_by_id")
  moderatedByName String?   @map("moderated_by_name")
  moderatedAt     DateTime? @map("moderated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([productId, userId])
  @@index([status, createdAt])
  @@index([productId, status, createdAt])
  @@map("product_reviews")
}

// A guest waiting for a book that's out on loan. When a copy comes back the first
// one waiting is told it's on the shelf; lending it to them closes the entry.
model BookWaitlistEntry {
  id         String    @id @default(uuid())
  productId  String    @map("product_id")
  bookTitle  String    @map("book_title")
  // The guest's profile, found or made by phone; null only on an old hold with no usable phone.
  userId     String?   @map("user_id")
  guestName  String    @map("guest_name")
  guestPhone String    @map("guest_phone")
  status     String    @default("waiting")
  notifiedAt DateTime? @map("notified_at")
  // Told guests collect by this instant (the end of a cafe day); after it the jobs skip them.
  pickupBy   DateTime? @map("pickup_by")
  // Set when the jobs skipped a told guest who didn't collect the book in time.
  expiredAt  DateTime? @map("expired_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, pickupBy])
  @@map("book_waitlist")
}

// A code guests type at checkout for money off. Uses are counted from the orders
// that carry it (cancelled ones give the use back).
model PromoCode {
  id             String    @id @default(uuid())
  // Stored upper-case; guests can type it in any case. Unique across archived codes
  // too, so a used code's name can't come back as a new code with fresh limits.
  code           String    @unique
  description    String?
  // percent | fixed
  kind           String
  // Whole percent (1–100) or Toman off.
  value          Int
  // Cap on a percent discount, in Toman.
  maxDiscount    Int?      @map("max_discount")
  minSubtotal    Int       @default(0) @map("min_subtotal")
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  usageLimit     Int?      @map("usage_limit")
  perGuestLimit  Int?      @map("per_guest_limit")
  isActive       Boolean   @default(true) @map("is_active")
  // Scope: the items and categories the code takes money off (both empty = the
  // whole order), and whether only a guest's first order may use it.
  productIds     String[]  @default([]) @map("product_ids")
  categoryIds    String[]  @default([]) @map("category_ids")
  firstOrderOnly Boolean   @default(false) @map("first_order_only")
  // Set when staff deleted a code orders had used: it's kept (so those orders still
  // resolve it) but gone from the list, never usable or switched on again. A code
  // no order ever used is deleted outright instead.
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("promo_codes")
}

// The loyalty club's points, as an append-only ledger per guest: the balance is the
// sum of the deltas. Earned on completed orders, spent at checkout, given back when
// an order that spent them is cancelled, and adjusted by hand.
model LoyaltyTransaction {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  delta         Int
  // earn | redeem | refund | adjust | expire
  reason        String
  orderId       String?  @map("order_id")
  orderNumber   Int?     @map("order_number")
  note          String?
  // Postings that must happen once (an order's earn) carry a key; a second is refused.
  dedupeKey     String?  @unique @map("dedupe_key")
  createdById   String?  @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("loyalty_transactions")
}

model LoyaltySettings {
  id                 Int       @id @default(1)
  enabled            Boolean   @default(true)
  // Spend this many Toman to earn one point.
  tomanPerPoint      Int       @default(10000) @map("toman_per_point")
  // One point takes this many Toman off an order.
  pointValue         Int       @default(1000) @map("point_value")
  // The fewest points a guest can spend at once.
  minRedeemPoints    Int       @default(50) @map("min_redeem_points")
  // A guest's points lapse after this many months without earning or spending; 0 = never.
  pointsExpiryMonths Int       @default(0) @map("points_expiry_months")
  // When expiry was switched on: months of inactivity before it don't count.
  pointsExpirySince  DateTime? @map("points_expiry_since")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("loyalty_settings")
}

// A till shift: opened with a float, closed by counting the drawer. The expected
// cash is the float plus everything the Cash account moved during the shift; any
// difference is booked as cash over/short when it closes.
model CashShift {
  id           String    @id @default(uuid())
  number       Int       @unique @default(autoincrement())
  status       String    @default("open")
  openedAt     DateTime  @default(now()) @map("opened_at")
  openedById   String    @map("opened_by_id")
  openedByName String    @map("opened_by_name")
  openingFloat BigInt    @map("opening_float")
  closedAt     DateTime? @map("closed_at")
  closedById   String?   @map("closed_by_id")
  closedByName String?   @map("closed_by_name")
  // Snapshotted at close: what the drawer should hold, what was counted, and counted − expected.
  // BigInt like the journal they come from: the expected cash isn't capped by the float.
  expectedCash BigInt?   @map("expected_cash")
  countedCash  BigInt?   @map("counted_cash")
  difference   BigInt?
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([openedAt])
  @@map("cash_shifts")
}

// ── Bank reconciliation ──────────────────────────────────────────────────────
// Bank statements matched line by line to the Bank account. The database keeps
// them honest too: matches balance and a reconciled statement is frozen (see the
// migration).

model BankStatement {
  id               String              @id @default(uuid())
  accountCode      String              @default("1120") @map("account_code")
  account          LedgerAccount       @relation(fields: [accountCode], references: [code], onDelete: Restrict)
  fromDay          DateTime            @map("from_day") @db.Date
  toDay            DateTime            @map("to_day") @db.Date
  openingBalance   BigInt              @map("opening_balance")
  closingBalance   BigInt              @map("closing_balance")
  // open | reconciled
  status           String              @default("open")
  lines            BankStatementLine[]
  matches          BankMatch[]
  createdById      String              @map("created_by_id")
  createdByName    String              @map("created_by_name")
  createdAt        DateTime            @default(now()) @map("created_at")
  reconciledById   String?             @map("reconciled_by_id")
  reconciledByName String?             @map("reconciled_by_name")
  reconciledAt     DateTime?           @map("reconciled_at")

  @@unique([accountCode, fromDay])
  @@index([accountCode, toDay])
  @@map("bank_statements")
}

model BankStatementLine {
  id          String        @id @default(uuid())
  statementId String        @map("statement_id")
  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  date        DateTime      @db.Date
  description String
  reference   String?
  // Signed whole Toman: positive into the account, negative out.
  amount      BigInt
  position    Int
  matchId     String?       @map("match_id")
  match       BankMatch?    @relation(fields: [matchId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([statementId, position])
  @@index([matchId])
  @@map("bank_statement_lines")
}

// Statement lines and ledger lines that are the same money; both sides total the same.
model BankMatch {
  id             String                @id @default(uuid())
  statementId    String                @map("statement_id")
  statement      BankStatement         @relation(fields: [statementId], references: [id], onDelete: Restrict)
  statementLines BankStatementLine[]
  ledgerLines    BankMatchLedgerLine[]
  createdById    String                @map("created_by_id")
  createdByName  String                @map("created_by_name")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([statementId])
  @@map("bank_matches")
}

model BankMatchLedgerLine {
  matchId       String      @map("match_id")
  match         BankMatch   @relation(fields: [matchId], references: [id], onDelete: Restrict)
  // A ledger line clears once.
  journalLineId String      @unique @map("journal_line_id")
  journalLine   JournalLine @relation(fields: [journalLineId], references: [id], onDelete: Restrict)

  @@id([matchId, journalLineId])
  @@map("bank_match_ledger_lines")
}
