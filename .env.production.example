# ── Rira Book Cafe production environment ────────────────────────────
# Copy to `/opt/rira/.env.production` ON THE SERVER and fill in real values.
# This .example file is safe to commit; the real `.env.production` is NOT.
# UPLOADS_DIR and API_BASE_URL are set by docker-compose.yml — don't set them here.

# ── PostgreSQL ───────────────────────────────────────────────────────
# Self-hosted in the `db` container. Host `db` is the compose service name.
POSTGRES_USER=rira
POSTGRES_PASSWORD=
POSTGRES_DB=rira
DATABASE_URL=postgresql://rira:PASSWORD@db:5432/rira?schema=public

# ── Auth.js ──────────────────────────────────────────────────────────
# Generate with `npx auth secret` (or `openssl rand -base64 32`).
AUTH_SECRET=

# Break-glass owner ids (normalized phones, comma-separated, e.g. 09121234567).
ADMIN_USER_IDS=

# ── SMS.ir (OTP login) ───────────────────────────────────────────────
# REQUIRED in production — without it the mock OTP shows the code on screen.
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
OTP_MOCK=false
# SMS_IR_ADMIN_INVITE_TEMPLATE_ID=
# SMS_IR_OWNERSHIP_RECEIVED_TEMPLATE_ID=
# SMS_IR_OWNERSHIP_LOST_TEMPLATE_ID=

# ── Email (team invitations) — optional; without SMTP emails are only logged ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Rira Book Cafe <no-reply@your-domain>

# ── Public origin ────────────────────────────────────────────────────
# Used for invitation links and the Zarinpal callback.
APP_URL=http://87.107.128.193
# NEXT_PUBLIC_SITE_URL=https://your-domain

# ── Error tracking (optional) ────────────────────────────────────────
# Sentry SaaS or self-hosted GlitchTip DSN. Empty = disabled. This is the
# server-side DSN, read at runtime. The browser DSN (NEXT_PUBLIC_SENTRY_DSN) is
# baked in at image build time — pass it as a Docker build arg, not here.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Zarinpal ─────────────────────────────────────────────────────────
# Without a merchant id (or with ZARINPAL_SANDBOX=true) payments use the sandbox.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
