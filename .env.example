# PostgreSQL connection used by Prisma (matches docker-compose.dev.yml).
DATABASE_URL=postgresql://rira:devpassword@localhost:5545/rira

# Auth.js — generate with `npx auth secret`.
AUTH_SECRET=

# Break-glass owner ids (comma-separated normalized phone digits, e.g. 09121234567).
# Bootstraps the first owner; manage everyone else from the dashboard.
ADMIN_USER_IDS=

# SMS.ir OTP. Leave empty (or set OTP_MOCK=true) to use the in-memory mock,
# which shows the code on the verify screen.
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
OTP_MOCK=
# Optional override of the SMS.ir API host.
SMS_IR_BASE_URL=

# Uploaded images (written to disk, served from /uploads). Defaults to ./storage/uploads.
UPLOADS_DIR=

# Every server-side variable is validated at boot (src/lib/env.ts): a malformed value
# stops the server with a list of what to fix. Empty `KEY=` lines count as unset.

# Optional: absolute API base for server-side BFF calls / public site URL for metadata.
API_BASE_URL=
NEXT_PUBLIC_SITE_URL=

# Team invitations / ownership notices. Optional — without SMTP, emails are logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional SMS.ir pattern templates for team notices (need SMS_IR_API_KEY).
SMS_IR_ADMIN_INVITE_TEMPLATE_ID=
SMS_IR_OWNERSHIP_RECEIVED_TEMPLATE_ID=
SMS_IR_OWNERSHIP_LOST_TEMPLATE_ID=
# Absolute public URL used in team invitation links (else derived from the request).
APP_URL=

# Seeding (npm run db:seed): this phone becomes the owner, e.g. 09121234567.
SEED_OWNER_PHONE=

# Log level: trace | debug | info | warn | error | fatal | silent. Defaults to
# debug in dev, info in production. Production logs are JSON lines on stdout.
LOG_LEVEL=

# Error tracking — Sentry SDK, works with Sentry SaaS or a self-hosted GlitchTip
# (paste either one's DSN). All optional: without a DSN nothing is sent.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# 0–1 share of requests traced (performance); empty/0 = errors only.
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Build-time source-map upload — only runs when SENTRY_AUTH_TOKEN is set.
# SENTRY_URL is the tracker's base URL when self-hosted (e.g. https://glitchtip.example).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=

# Zarinpal online payments. Without a merchant id (or with ZARINPAL_SANDBOX=true)
# payments go to Zarinpal's sandbox and no money moves. The callback URL is built
# from APP_URL (else the request's host), so set APP_URL behind a proxy.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=

# Reverse proxies in front of the app whose X-Forwarded-For entry is trusted when
# rate limiting by client IP. 1 = the host nginx (default); raise it only if another
# proxy (e.g. a CDN) sits in front of nginx.
TRUSTED_PROXY_HOPS=
