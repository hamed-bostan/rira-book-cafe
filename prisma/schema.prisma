// Rira Book Cafe database schema.
// Data lives in PostgreSQL. Images live in Supabase Storage — rows store only the image's URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // id is the user's normalized phone digits — the stable identifier carried on
  // the Auth.js session (and matched against ADMIN_USER_IDS), so it is supplied
  // at creation rather than database-generated.
  id        String   @id
  phone     String
  name      String
  email     String?
  avatarUrl String?  @map("avatar_url")
  // Access level: "customer" (default), "support", "staff", "admin", or "owner" —
  // stored as a plain string matching the domain union (enum-free style). This is
  // the source of truth for dashboard access; ADMIN_USER_IDS remains only as a
  // break-glass allowlist so an owner can always get back in.
  role      String   @default("customer")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  iconUrl   String   @map("icon_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("categories")
}

model CategoryTranslation {
  id         String   @id @default(uuid())
  categoryId String   @map("category_id")
  locale     String
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([categoryId, locale])
  @@index([categoryId])
  @@map("category_translations")
}

// A menu item: a drink, a food item, or a book on the shelf. Prices are whole
// Toman. Book columns are set only when kind = "book" (the repository clears them
// otherwise); kind and book_availability are plain strings matching the domain
// unions (enum-free style).
model Product {
  id               String       @id @default(uuid())
  kind             String       @default("drink")
  name             String
  price            Int
  originalPrice    Int?         @map("original_price")
  // What one unit costs the cafe (Toman), for cost of sales. Never shown to guests.
  costPrice        Int?         @map("cost_price")
  rating           Float        @default(0)
  ratingCount      Int          @default(0) @map("rating_count")
  stockQuantity    Int          @default(0) @map("stock_quantity")
  imageUrl         String       @map("image_url")
  categoryId       String       @map("category_id")
  isFeatured       Boolean      @default(false) @map("is_featured")
  isPublished      Boolean      @default(true) @map("is_published")
  badge            String?
  unit             String?
  description      String?
  nutrition        String?
  origin           String?
  dietary          String[]     @default([])
  // VAT-exempt (books, in Iran). Prices are VAT-inclusive; exempt items carry none.
  taxExempt        Boolean      @default(false) @map("tax_exempt")
  bookAuthor       String?      @map("book_author")
  bookIsbn         String?      @map("book_isbn")
  bookAvailability String?      @map("book_availability")
  // The owner's profit target for this item, as a markup on full cost in basis
  // points (3000 = 30%); null uses the cafe-wide default in pricing settings.
  targetMarkupBps  Int?         @map("target_markup_bps")
  recipeLines      RecipeLine[]
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isPublished])
  @@index([kind])
  @@map("products")
}

model ProductTranslation {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  locale      String
  name        String
  unit        String?
  description String?
  nutrition   String?
  origin      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([productId, locale])
  @@index([productId])
  @@map("product_translations")
}

// Append-only audit trail of admin changes. Written by repositories inside the
// same transaction as the change they describe.
model ActivityEntry {
  id            String   @id @default(uuid())
  actorId       String   @map("actor_id")
  actorName     String   @map("actor_name")
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  entityLabel   String?  @map("entity_label")
  // `[{ field, before, after }]` with string values.
  changes       Json
  // Field names from `changes`, denormalized so "every price change" is an index scan.
  changedFields String[] @map("changed_fields")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("activity_log")
}

// A cafe order. Guest name/phone and every line's name/price are snapshotted at
// placement so the order reads correctly after the menu or the account changes.
// status / service_type / payment_status are plain strings matching the domain
// unions (enum-free style).
model Order {
  id              String           @id @default(uuid())
  // Short sequential number staff call out.
  orderNumber     Int              @unique @default(autoincrement()) @map("order_number")
  userId          String           @map("user_id")
  customerName    String           @map("customer_name")
  customerPhone   String           @map("customer_phone")
  status          String           @default("pending")
  serviceType     String           @map("service_type")
  tableLabel      String?          @map("table_label")
  note            String?
  paymentStatus   String           @default("unpaid") @map("payment_status")
  // cash | card | transfer | online, once paid (kept after a refund).
  paymentMethod   String?          @map("payment_method")
  subtotal        Int
  // The promo code applied at placement (snapshotted text; the id counts its uses).
  promoCodeId     String?          @map("promo_code_id")
  promoCode       String?          @map("promo_code")
  promoDiscount   Int              @default(0) @map("promo_discount")
  // Loyalty points spent on this order, and the Toman they took off.
  pointsRedeemed  Int              @default(0) @map("points_redeemed")
  pointsDiscount  Int              @default(0) @map("points_discount")
  // Points the guest earned when it was completed.
  pointsEarned    Int              @default(0) @map("points_earned")
  total           Int
  items           OrderItem[]
  paymentAttempts PaymentAttempt[]
  placedAt        DateTime         @default(now()) @map("placed_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([status, placedAt])
  @@index([userId, placedAt])
  @@index([promoCodeId])
  @@map("orders")
}

model OrderItem {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Plain reference, not a foreign key: deleting a menu item must not touch history.
  productId    String    @map("product_id")
  kind         String
  name         String
  imageUrl     String    @map("image_url")
  unitPrice    Int       @map("unit_price")
  // Cost per unit when placed, if the item had one — for cost of sales.
  unitCost     Int?      @map("unit_cost")
  // Whether the item was VAT-exempt when placed (books are); the sale's VAT comes from the rest.
  taxExempt    Boolean   @default(false) @map("tax_exempt")
  // Set at completion when the line's recipe was taken out of stock (unit_cost is then actual).
  stockTracked Boolean   @default(false) @map("stock_tracked")
  quantity     Int
  note         String?
  position     Int
  // When staff marked the line served; null while it's still being prepared.
  servedAt     DateTime? @map("served_at")

  @@index([orderId])
  @@map("order_items")
}

// One try at paying an order online (see domain/entities/PaymentAttempt).
// Amounts are whole Toman, like the order's total.
model PaymentAttempt {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // zarinpal
  provider      String
  // The gateway's id for the try; a callback names exactly one attempt.
  authority     String   @unique
  amount        Int
  // pending | verifying | paid | failed | unapplied
  status        String   @default("pending")
  // The order id while the attempt is live (pending/verifying), null after: the
  // unique index allows one live attempt per order.
  liveOrderId   String?  @unique @map("live_order_id")
  failureReason String?  @map("failure_reason")
  gatewayCode   String?  @map("gateway_code")
  refId         String?  @map("ref_id")
  cardPan       String?  @map("card_pan")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([orderId, createdAt])
  @@map("payment_attempts")
}

// Append-only: one row per status change (and one for placement, with from = null).
model OrderStatusEvent {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorId    String   @map("actor_id")
  actorName  String   @map("actor_name")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model OrderNote {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  authorId   String   @map("author_id")
  authorName String   @map("author_name")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_notes")
}

// A table booking. status is a plain string matching the domain union.
model Reservation {
  id              String   @id @default(uuid())
  reference       Int      @unique @default(autoincrement())
  userId          String   @map("user_id")
  guestName       String   @map("guest_name")
  guestPhone      String   @map("guest_phone")
  partySize       Int      @map("party_size")
  startsAt        DateTime @map("starts_at")
  durationMinutes Int      @map("duration_minutes")
  status          String   @default("requested")
  tableLabel      String?  @map("table_label")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // The floor's day view, and the table-clash check.
  @@index([startsAt])
  @@index([tableLabel, startsAt])
  @@index([userId, startsAt])
  @@map("reservations")
}

// A stay in the cafe's suite. check_in/check_out are cafe days; the guest sleeps
// the nights from check_in up to (not including) check_out. Two stays holding the
// suite (confirmed, checkedIn) can't overlap — also enforced by an exclusion
// constraint in the migration, not only in app code.
model SuiteBooking {
  id         String   @id @default(uuid())
  reference  Int      @unique @default(autoincrement())
  userId     String   @map("user_id")
  guestName  String   @map("guest_name")
  guestPhone String   @map("guest_phone")
  guests     Int
  checkIn    DateTime @map("check_in") @db.Date
  checkOut   DateTime @map("check_out") @db.Date
  status     String   @default("requested")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([checkOut, checkIn])
  @@index([userId, checkIn])
  @@map("suite_bookings")
}

// A book lent from the shelf: who has it and when it's due back. The book's title
// is snapshotted, like an order line, so the record survives the catalog changing.
// One borrower can't hold two open loans of the same book (partial unique index in
// the migration).
model BookLoan {
  id            String    @id @default(uuid())
  reference     Int       @unique @default(autoincrement())
  productId     String    @map("product_id")
  bookTitle     String    @map("book_title")
  bookAuthor    String?   @map("book_author")
  userId        String?   @map("user_id")
  borrowerName  String    @map("borrower_name")
  borrowerPhone String    @map("borrower_phone")
  lentAt        DateTime  @map("lent_at")
  dueAt         DateTime  @map("due_at")
  status        String    @default("out")
  returnedAt    DateTime? @map("returned_at")
  note          String?
  lentById      String    @map("lent_by_id")
  lentByName    String    @map("lent_by_name")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, dueAt])
  @@index([productId, status])
  @@index([borrowerPhone])
  @@index([userId, lentAt])
  @@map("book_loans")
}

// Something guests sign up for — a book club, a reading, a workshop.
model Event {
  id            String              @id @default(uuid())
  kind          String
  title         String
  description   String?
  titleFa       String?             @map("title_fa")
  descriptionFa String?             @map("description_fa")
  imageUrl      String?             @map("image_url")
  startsAt      DateTime            @map("starts_at")
  endsAt        DateTime            @map("ends_at")
  // Null means no seat limit.
  capacity      Int?
  // Toman; 0 is free.
  price         Int                 @default(0)
  isPublished   Boolean             @default(false) @map("is_published")
  registrations EventRegistration[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([isPublished, startsAt])
  @@map("events")
}

model EventRegistration {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId     String   @map("user_id")
  guestName  String   @map("guest_name")
  guestPhone String   @map("guest_phone")
  seats      Int
  status     String   @default("registered")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventId, status])
  @@index([userId, createdAt])
  @@map("event_registrations")
}

// ── Accounting ───────────────────────────────────────────────────────────────
// Double-entry general ledger in whole Toman. Amounts are BIGINT so large
// purchases can't overflow. Balance, immutability and amount rules are also
// enforced in the database (see the accounting migration), not only in app code.

model LedgerAccount {
  // Stable code; the first digit is the type (1 asset, 2 liability, 3 equity, 4 revenue, 5–6 expense).
  code           String          @id
  name           String
  nameFa         String          @map("name_fa")
  // asset | liability | equity | revenue | expense
  type           String
  isSystem       Boolean         @default(false) @map("is_system")
  isActive       Boolean         @default(true) @map("is_active")
  lines          JournalLine[]
  expenses       Expense[]
  bankStatements BankStatement[]
  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("ledger_accounts")
}

model JournalEntry {
  id            String        @id @default(uuid())
  number        Int           @unique @default(autoincrement())
  // The accounting date (a cafe day).
  date          DateTime      @db.Date
  description   String
  source        String
  sourceId      String?       @map("source_id")
  // Postings that must happen once (an order's sale) carry a key; a second is refused.
  uniqueKey     String?       @unique @map("unique_key")
  // On a reversing entry: the entry it reverses (each entry can be reversed once).
  reversesId    String?       @unique @map("reverses_id")
  // On a reversed entry: the reversing entry. The only column that may change after posting.
  reversedById  String?       @map("reversed_by_id")
  createdById   String        @map("created_by_id")
  createdByName String        @map("created_by_name")
  lines         JournalLine[]
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([date])
  @@index([source, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id          String               @id @default(uuid())
  entryId     String               @map("entry_id")
  entry       JournalEntry         @relation(fields: [entryId], references: [id], onDelete: Restrict)
  accountCode String               @map("account_code")
  account     LedgerAccount        @relation(fields: [accountCode], references: [code], onDelete: Restrict)
  debit       BigInt               @default(0)
  credit      BigInt               @default(0)
  memo        String?
  position    Int
  bankMatch   BankMatchLedgerLine?

  @@index([entryId])
  @@index([accountCode])
  @@map("journal_lines")
}

// One row (id = 1).
model AccountingSettings {
  id                 Int       @id @default(1)
  // VAT included in menu prices, in basis points (1000 = 10%).
  vatRateBps         Int       @default(1000) @map("vat_rate_bps")
  // Nothing may be posted on or before this day.
  booksClosedThrough DateTime? @map("books_closed_through") @db.Date
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("accounting_settings")
}

model Supplier {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  note      String?
  isActive  Boolean   @default(true) @map("is_active")
  expenses  Expense[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("suppliers")
}

model Expense {
  id            String        @id @default(uuid())
  number        Int           @unique @default(autoincrement())
  date          DateTime      @db.Date
  supplierId    String?       @map("supplier_id")
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName  String?       @map("supplier_name")
  accountCode   String        @map("account_code")
  account       LedgerAccount @relation(fields: [accountCode], references: [code], onDelete: Restrict)
  description   String
  amount        BigInt
  vatAmount     BigInt        @default(0) @map("vat_amount")
  // unpaid | paid | void
  status        String
  // cash | bank, once paid
  paidFrom      String?       @map("paid_from")
  paidOn        DateTime?     @map("paid_on") @db.Date
  receiptUrl    String?       @map("receipt_url")
  createdById   String        @map("created_by_id")
  createdByName String        @map("created_by_name")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([date])
  @@index([status])
  @@index([supplierId])
  @@map("expenses")
}

// --- Pricing: ingredients, recipes and the advisor's settings.

// Something menu items are made from, priced as bought: purchase_price Toman for
// purchase_quantity units (g, ml or piece).
model Ingredient {
  id               String          @id @default(uuid())
  name             String
  unit             String
  purchasePrice    Int             @map("purchase_price")
  purchaseQuantity Float           @map("purchase_quantity")
  isActive         Boolean         @default(true) @map("is_active")
  // Perpetual inventory: on hand (in unit), its value in Toman (always equal to
  // what the Inventory account holds for it), weighted average cost per unit, and
  // the level at or below which it shows as running low.
  onHand           Float           @default(0) @map("on_hand")
  stockValue       BigInt          @default(0) @map("stock_value")
  averageCost      Float           @default(0) @map("average_cost")
  reorderLevel     Float?          @map("reorder_level")
  recipeLines      RecipeLine[]
  stockMovements   StockMovement[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("ingredients")
}

// One ingredient in a menu item's recipe. An ingredient in use can't be deleted
// (Restrict) — it's switched off instead.
model RecipeLine {
  id           String     @id @default(uuid())
  productId    String     @map("product_id")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String     @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Float
  position     Int

  @@unique([productId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_lines")
}

// The pricing advisor's settings — a single row.
model PricingSettings {
  id                    Int      @id @default(1)
  defaultMarkupBps      Int      @default(3000) @map("default_markup_bps")
  roundingStep          Int      @default(5000) @map("rounding_step")
  overheadSource        String   @default("ledger") @map("overhead_source")
  manualMonthlyOverhead BigInt?  @map("manual_monthly_overhead")
  expectedMonthlyUnits  Int?     @map("expected_monthly_units")
  overheadMonths        Int      @default(3) @map("overhead_months")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("pricing_settings")
}

// One change to one stock item — append-only, like the journal. Quantity and value
// are signed (in positive, out negative); reference_id is the order, receipt
// (expense) or count it belongs to.
model StockMovement {
  id            String     @id @default(uuid())
  ingredientId  String     @map("ingredient_id")
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  kind          String
  quantity      Float
  value         BigInt
  date          DateTime   @db.Date
  referenceId   String?    @map("reference_id")
  note          String?
  createdById   String     @map("created_by_id")
  createdByName String     @map("created_by_name")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([ingredientId, date])
  @@index([referenceId])
  @@index([date])
  @@map("stock_movements")
}

// A message to one guest, shown on their account (no SMS): an order is ready, a
// booking was confirmed, a borrowed book is due. The copy is rendered from `kind`
// and `params` in the guest's language.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  kind      String
  // The values the message is filled with, e.g. `{ "orderNumber": 42 }`.
  params    Json      @default("{}")
  // Where tapping it goes, a site path such as `/orders/…`.
  link      String?
  // Notifications that must happen at most once (a loan's due-soon reminder) carry a key.
  dedupeKey String?   @unique @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

// A guest's star rating (and optional words) for something they bought. Shown once
// staff approve it; the item's rating is the average of its approved reviews.
model ProductReview {
  id              String    @id @default(uuid())
  productId       String    @map("product_id")
  productName     String    @map("product_name")
  userId          String    @map("user_id")
  authorName      String    @map("author_name")
  rating          Int
  comment         String?
  status          String    @default("pending")
  moderatedById   String?   @map("moderated_by_id")
  moderatedByName String?   @map("moderated_by_name")
  moderatedAt     DateTime? @map("moderated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([productId, userId])
  @@index([status, createdAt])
  @@index([productId, status, createdAt])
  @@map("product_reviews")
}

// A guest waiting for a book that's out on loan. When a copy comes back the first
// one waiting is told it's on the shelf; lending it to them closes the entry.
model BookWaitlistEntry {
  id         String    @id @default(uuid())
  productId  String    @map("product_id")
  bookTitle  String    @map("book_title")
  userId     String    @map("user_id")
  guestName  String    @map("guest_name")
  guestPhone String    @map("guest_phone")
  status     String    @default("waiting")
  notifiedAt DateTime? @map("notified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@map("book_waitlist")
}

// A code guests type at checkout for money off. Uses are counted from the orders
// that carry it (cancelled ones give the use back).
model PromoCode {
  id            String    @id @default(uuid())
  // Stored upper-case; guests can type it in any case.
  code          String    @unique
  description   String?
  // percent | fixed
  kind          String
  // Whole percent (1–100) or Toman off.
  value         Int
  // Cap on a percent discount, in Toman.
  maxDiscount   Int?      @map("max_discount")
  minSubtotal   Int       @default(0) @map("min_subtotal")
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  usageLimit    Int?      @map("usage_limit")
  perGuestLimit Int?      @map("per_guest_limit")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("promo_codes")
}

// The loyalty club's points, as an append-only ledger per guest: the balance is the
// sum of the deltas. Earned on completed orders, spent at checkout, given back when
// an order that spent them is cancelled, and adjusted by hand.
model LoyaltyTransaction {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  delta         Int
  // earn | redeem | refund | adjust
  reason        String
  orderId       String?  @map("order_id")
  orderNumber   Int?     @map("order_number")
  note          String?
  // Postings that must happen once (an order's earn) carry a key; a second is refused.
  dedupeKey     String?  @unique @map("dedupe_key")
  createdById   String?  @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("loyalty_transactions")
}

model LoyaltySettings {
  id              Int      @id @default(1)
  enabled         Boolean  @default(true)
  // Spend this many Toman to earn one point.
  tomanPerPoint   Int      @default(10000) @map("toman_per_point")
  // One point takes this many Toman off an order.
  pointValue      Int      @default(1000) @map("point_value")
  // The fewest points a guest can spend at once.
  minRedeemPoints Int      @default(50) @map("min_redeem_points")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("loyalty_settings")
}

// A till shift: opened with a float, closed by counting the drawer. The expected
// cash is the float plus everything the Cash account moved during the shift; any
// difference is booked as cash over/short when it closes.
model CashShift {
  id           String    @id @default(uuid())
  number       Int       @unique @default(autoincrement())
  status       String    @default("open")
  openedAt     DateTime  @default(now()) @map("opened_at")
  openedById   String    @map("opened_by_id")
  openedByName String    @map("opened_by_name")
  openingFloat Int       @map("opening_float")
  closedAt     DateTime? @map("closed_at")
  closedById   String?   @map("closed_by_id")
  closedByName String?   @map("closed_by_name")
  // Snapshotted at close: what the drawer should hold, what was counted, and counted − expected.
  expectedCash Int?      @map("expected_cash")
  countedCash  Int?      @map("counted_cash")
  difference   Int?
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([openedAt])
  @@map("cash_shifts")
}

// ── Bank reconciliation ──────────────────────────────────────────────────────
// Bank statements matched line by line to the Bank account. The database keeps
// them honest too: matches balance and a reconciled statement is frozen (see the
// migration).

model BankStatement {
  id               String              @id @default(uuid())
  accountCode      String              @default("1120") @map("account_code")
  account          LedgerAccount       @relation(fields: [accountCode], references: [code], onDelete: Restrict)
  fromDay          DateTime            @map("from_day") @db.Date
  toDay            DateTime            @map("to_day") @db.Date
  openingBalance   BigInt              @map("opening_balance")
  closingBalance   BigInt              @map("closing_balance")
  // open | reconciled
  status           String              @default("open")
  lines            BankStatementLine[]
  matches          BankMatch[]
  createdById      String              @map("created_by_id")
  createdByName    String              @map("created_by_name")
  createdAt        DateTime            @default(now()) @map("created_at")
  reconciledById   String?             @map("reconciled_by_id")
  reconciledByName String?             @map("reconciled_by_name")
  reconciledAt     DateTime?           @map("reconciled_at")

  @@unique([accountCode, fromDay])
  @@index([accountCode, toDay])
  @@map("bank_statements")
}

model BankStatementLine {
  id          String        @id @default(uuid())
  statementId String        @map("statement_id")
  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  date        DateTime      @db.Date
  description String
  reference   String?
  // Signed whole Toman: positive into the account, negative out.
  amount      BigInt
  position    Int
  matchId     String?       @map("match_id")
  match       BankMatch?    @relation(fields: [matchId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([statementId, position])
  @@index([matchId])
  @@map("bank_statement_lines")
}

// Statement lines and ledger lines that are the same money; both sides total the same.
model BankMatch {
  id             String                @id @default(uuid())
  statementId    String                @map("statement_id")
  statement      BankStatement         @relation(fields: [statementId], references: [id], onDelete: Restrict)
  statementLines BankStatementLine[]
  ledgerLines    BankMatchLedgerLine[]
  createdById    String                @map("created_by_id")
  createdByName  String                @map("created_by_name")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([statementId])
  @@map("bank_matches")
}

model BankMatchLedgerLine {
  matchId       String      @map("match_id")
  match         BankMatch   @relation(fields: [matchId], references: [id], onDelete: Restrict)
  // A ledger line clears once.
  journalLineId String      @unique @map("journal_line_id")
  journalLine   JournalLine @relation(fields: [journalLineId], references: [id], onDelete: Restrict)

  @@id([matchId, journalLineId])
  @@map("bank_match_ledger_lines")
}
